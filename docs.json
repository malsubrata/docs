{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TeraWallet Documentation",
  "description": "Official documentation for TeraWallet — the leading digital wallet plugin for WooCommerce. Top-ups, partial payments, cashback, transfers, multi-currency and a full REST API.",
  "logo": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo.png"
  },
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#16A34A",
    "light": "#4ade80",
    "dark": "#15803d"
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:type": "website",
      "og:site_name": "TeraWallet Documentation",
      "og:title": "TeraWallet Documentation",
      "og:description": "Official documentation for TeraWallet — the leading digital wallet plugin for WooCommerce.",
      "og:image": "/images/hero.png",
      "twitter:card": "summary_large_image",
      "twitter:title": "TeraWallet Documentation",
      "twitter:description": "Official documentation for TeraWallet — the leading digital wallet plugin for WooCommerce.",
      "twitter:image": "/images/hero.png"
    }
  },
  "topbarLinks": [
    {
      "name": "Support",
      "url": "https://standalonetech.com/support"
    }
  ],
  "navigation": {
    "products": [
      {
        "product": "TeraWallet",
        "icon": "wallet",
        "description": "Free digital wallet plugin for WooCommerce",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Get Started",
                "pages": [
                  "terawallet/index",
                  "terawallet/getting-started/key-features",
                  "terawallet/getting-started/installation",
                  "terawallet/getting-started/configuration",
                  "terawallet/getting-started/pro"
                ]
              },
              {
                "group": "User Guide",
                "pages": [
                  "terawallet/user-guide/wallet-dashboard",
                  "terawallet/user-guide/partial-payments"
                ]
              },
              {
                "group": "Admin Guide",
                "pages": [
                  "terawallet/admin-guide/settings",
                  "terawallet/admin-guide/transactions"
                ]
              },
              {
                "group": "Cashback System",
                "pages": [
                  "terawallet/cashback/rules-logic"
                ]
              }
            ]
          },
          {
            "tab": "Developers",
            "groups": [
              {
                "group": "Developer Guide",
                "pages": [
                  "terawallet/developer-guide/architecture",
                  "terawallet/developer-guide/hooks",
                  "terawallet/developer-guide/rest-api"
                ]
              }
            ]
          },
          {
            "tab": "Help",
            "groups": [
              {
                "group": "FAQ & Troubleshooting",
                "pages": [
                  "terawallet/faq/troubleshooting"
                ]
              },
              {
                "group": "Releases",
                "pages": [
                  "terawallet/releases/changelog"
                ]
              }
            ]
          }
        ]
      },
      {
        "product": "TeraWallet Pro",
        "icon": "crown",
        "description": "Withdrawals, expiry, coupons, importer and AffiliateWP",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Get Started",
                "pages": [
                  "terawallet-pro/index",
                  "terawallet-pro/installation"
                ]
              },
              {
                "group": "Features",
                "pages": [
                  "terawallet-pro/withdrawal",
                  "terawallet-pro/wallet-expiry",
                  "terawallet-pro/wallet-coupons",
                  "terawallet-pro/importer",
                  "terawallet-pro/affiliatewp"
                ]
              },
              {
                "group": "Payout Gateways",
                "pages": [
                  "terawallet-pro/paypal-withdrawal"
