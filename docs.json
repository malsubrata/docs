              }
            ]
          },
          {
            "tab": "Reference",
            "groups": [
              {
                "group": "Reference",
                "pages": [
                  "terawallet-pro/settings",
                  "terawallet-pro/hooks"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/malsubrata/woo-wallet"
    }
  },
  "redirects": [
    {
      "source": "/getting-started/:slug*",
      "destination": "/terawallet/getting-started/:slug*"
    },
    {
      "source": "/user-guide/:slug*",
      "destination": "/terawallet/user-guide/:slug*"
    },
    {
      "source": "/admin-guide/:slug*",
      "destination": "/terawallet/admin-guide/:slug*"
    },
    {
      "source": "/cashback/:slug*",
      "destination": "/terawallet/cashback/:slug*"
    },
    {
      "source": "/developer-guide/:slug*",
      "destination": "/terawallet/developer-guide/:slug*"
    },
    {
      "source": "/faq/:slug*",
      "destination": "/terawallet/faq/:slug*"
    },
    {
      "source": "/releases/:slug*",
      "destination": "/terawallet/releases/:slug*"
    },
    {
      "source": "/pro",
      "destination": "/terawallet-pro/index"
    },
    {
      "source": "/pro/:slug*",
      "destination": "/terawallet-pro/:slug*"
    }
  ]
